/* rpx是微信自适应单位：屏幕宽度固定换算为750rpx，不同手机会自动缩放。 */
page{background:#f4f7f0;color:#243d2e;font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.6}.page{padding:36rpx 32rpx 60rpx}.eyebrow{font-size:18rpx;letter-spacing:4rpx;color:#83927f}.title{font-size:48rpx;font-weight:700;margin:12rpx 0 18rpx}.subtitle{color:#7b8c79;font-size:24rpx}.card{background:#fff;border:1rpx solid #e4eadd;border-radius:26rpx;padding:30rpx;margin-top:26rpx}.card-title{font-size:30rpx;font-weight:600;margin-bottom:22rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.tag{font-size:20rpx;padding:5rpx 13rpx;color:#21654e;background:#e6f1e3;border-radius:10rpx;white-space:nowrap}.tag.warn{color:#a76623;background:#fff0d9}.muted{color:#8b9986;font-size:23rpx}.primary{background:#21654e!important;color:white!important;border:0;border-radius:16rpx;font-size:28rpx}.secondary{background:#edf3e8!important;color:#21654e!important;border-radius:16rpx;font-size:26rpx}.danger{color:#b55246!important;background:#fbefeb!important;font-size:26rpx;border-radius:16rpx}button{font-size:26rpx;margin-top:22rpx;border-radius:16rpx}button::after{border:0}button[disabled]{opacity:.5}input{background:#f5f8f2;border:1rpx solid #e0e8d9;padding:22rpx;border-radius:14rpx;margin:18rpx 0;font-size:28rpx}picker{border:1rpx solid #e2e9dc;background:#f7f9f4;padding:19rpx;border-radius:12rpx;margin:16rpx 0}.empty{text-align:center;color:#8b9986;font-size:24rpx;padding:45rpx 0}.line{height:1rpx;background:#edf1e7;margin:24rpx 0}.amount{font-size:46rpx;font-weight:700;color:#21654e}.small{font-size:21rpx}.error{color:#b25340;font-size:24rpx}.actions{display:flex;gap:16rpx}.actions button{flex:1}.steps{background:#f4f7ef;border-radius:16rpx;padding:20rpx;font-size:23rpx;line-height:1.9}.footnote{margin-top:35rpx;color:#91a087;font-size:20rpx;text-align:center}.label{font-size:24rpx;color:#72856a;margin-top:18rpx}.item-row{display:flex;align-items:center;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #edf1e7}.icon{font-size:60rpx;margin-right:24rpx}.content{flex:1}.badge-title{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
