.session-head{display:flex;justify-content:space-between;align-items:center;margin-top:24rpx}.goods-row{display:flex;align-items:center;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #edf1e7}.thumb{width:105rpx;height:105rpx;background:#f5f7f1;border-radius:16rpx;flex-shrink:0}.goods-content{flex:1;min-width:0}.item-price{font-weight:600}.total-row{display:flex;align-items:center;justify-content:space-between;margin-top:22rpx}.pending-row{display:flex;align-items:center;gap:14rpx;padding:24rpx 0;border-bottom:1rpx solid #edf1e7}.choose{margin:0;background:#edf3e8;color:#21654e;padding:0 20rpx;font-size:24rpx;flex-shrink:0}.edit{margin:0;padding:0 18rpx;background:#edf3e8;color:#21654e;font-size:23rpx}.cancel{background:transparent;color:#8b9986;font-size:24rpx}.settle{margin-top:28rpx}
