<view class="page">
  <view class="eyebrow">YOUR SHOPPING BAG</view><view class="title">核对一下，就好。</view>
  <view wx:if="{{error}}" class="card error">{{error}}<button bindtap="refreshTap">重新加载</button><button bindtap="home">返回首页</button></view>
  <block wx:if="{{session}}">
    <view class="session-head"><text class="muted">柜号 {{session.cabinet_id}}</text><text class="tag">{{session.label}}</text></view>
    <view class="card" wx:if="{{session.state === 'OPEN'}}"><view class="card-title">柜门已打开</view><view class="muted">选好商品后关闭柜门，清单会自动更新。</view><button class="primary" bindtap="close" disabled="{{busy}}">结束购物，关柜</button></view>
    <block wx:if="{{session.state === 'OPEN' || session.state === 'REVIEW'}}">
      <view class="card"><view wx:if="{{session.state === 'REVIEW'}}" class="muted">已感知关柜，请核对商品后支付。</view><view class="card-title">已确认商品</view><view class="muted" wx:if="{{session.basketError}}">请核对下方已确认项目的商品、数量和取放方向。</view><view class="goods-row" wx:for="{{session.items}}" wx:key="productId"><image class="thumb" src="{{item.image}}" mode="aspectFit"/><view class="goods-content"><view>{{item.name}}</view><view class="muted">¥{{item.price}} × {{item.quantity}}</view></view><text class="item-price">¥{{item.subtotal}}</text></view><view class="empty" wx:if="{{!session.items.length}}">暂无已确认商品</view><view class="total-row"><text class="muted">{{session.pendingCount ? '已确认商品小计' : '合计'}}</text><text class="amount">¥{{session.total}}</text></view></view>
      <view class="card" wx:if="{{pending.length}}"><view class="badge-title"><view class="card-title">需要你确认</view><text class="tag warn">{{pending.length}} 项</text></view><view class="muted">{{session.state === 'OPEN' ? '关柜后，点击选择实际取放的商品。' : '点击下方项目，选择实际取放的商品。'}}</view><view class="pending-row" wx:for="{{pending}}" wx:key="id"><view class="goods-content"><view>{{item.title}}</view><view class="muted">{{item.hint}}</view></view><button class="choose" bindtap="resolve" data-id="{{item.id}}" disabled="{{busy || session.state !== 'REVIEW'}}">去选择 →</button></view></view>
      <view class="card" wx:if="{{reviewed.length && session.state === 'REVIEW'}}"><view class="card-title">已核对项目</view><view class="item-row" wx:for="{{reviewed}}" wx:key="id"><text class="muted">{{item.title}}</text><button class="edit" bindtap="resolve" data-id="{{item.id}}">修改</button></view></view>
      <view class="settle" wx:if="{{session.state === 'REVIEW'}}"><button class="primary" bindtap="confirmList" disabled="{{busy || session.pendingCount > 0 || session.basketError}}">确认清单 · ¥{{session.total}}</button><button class="cancel" bindtap="cancel" disabled="{{busy}}">取消订单</button></view>
    </block>
    <view class="card" wx:if="{{session.order && (session.state === 'UNPAID' || session.state === 'PAID')}}"><view class="card-title">{{session.state === 'PAID' ? '购物完成' : '待支付'}}</view><view class="goods-row" wx:for="{{session.order.items}}" wx:key="productId"><image class="thumb" src="{{item.image}}" mode="aspectFit"/><view class="goods-content"><view>{{item.name}}</view><view class="muted">¥{{item.price}} × {{item.quantity}}</view></view><text>¥{{item.subtotal}}</text></view><view class="total-row"><text class="muted">合计</text><text class="amount">¥{{session.order.amount}}</text></view></view>
    <view class="card" wx:if="{{session.state === 'UNPAID'}}"><view class="muted">本系统使用模拟支付，不产生真实扣款。</view><button class="primary" data-success="true" bindtap="pay" disabled="{{busy}}">模拟支付 · ¥{{session.order.amount}}</button><button class="secondary" data-success="false" bindtap="pay" disabled="{{busy}}">演示支付失败</button><button class="cancel" bindtap="cancel" disabled="{{busy}}">取消订单</button></view>
    <view class="card empty" wx:if="{{session.state === 'CANCELLED'}}">订单已取消</view>
    <button wx:if="{{session.state === 'PAID' || session.state === 'CANCELLED'}}" class="primary" bindtap="home">返回首页</button>
  </block>
</view>
