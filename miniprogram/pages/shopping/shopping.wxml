<view class="page">
  <view class="eyebrow">YOUR SHOPPING SESSION</view><view class="title">取放自由，清单透明。</view>
  <view wx:if="{{error}}" class="card error">{{error}}<button bindtap="refreshTap">重新连接</button><button bindtap="home">返回首页</button></view>
  <block wx:if="{{session}}">
    <view class="card"><view class="badge-title"><view class="card-title">{{session.cabinet_id}}</view><text class="tag">{{session.label}}</text></view><view class="muted">会话 {{session.id}}</view><view class="steps" wx:if="{{session.state === 'OPEN'}}">柜门已打开。请在电脑仿真面板模拟取放商品；这里会自动更新识别结果。</view><button wx:if="{{session.state === 'OPEN'}}" class="primary" bindtap="close" disabled="{{busy}}">结束购物，模拟关柜</button><view wx:if="{{session.state === 'PAID'}}" class="steps">✓ 模拟支付完成。订单和库存销量已更新。</view><view wx:if="{{session.state === 'CANCELLED'}}" class="steps">订单已取消，柜体恢复可用。</view></view>
    <view class="card" wx:if="{{session.state !== 'PAID' && session.state !== 'CANCELLED'}}"><view class="card-title">实时购物清单</view><view wx:if="{{session.basketError}}" class="error">{{session.basketError}}</view><view class="item-row" wx:for="{{session.items}}" wx:key="productId"><view><view>{{item.name}} × {{item.quantity}}</view><view class="muted">单价 ¥{{item.price}}</view></view><view>¥{{item.subtotal}}</view></view><view wx:if="{{!session.items.length}}" class="empty">尚无已确认的净取出商品</view><view class="row"><text class="muted">预估合计</text><text class="amount">¥{{session.total}}</text></view><view class="muted">还有 {{session.pendingCount}} 个待确认事件。关柜后请逐条核实。</view></view>
    <view class="card" wx:if="{{session.order && session.state !== 'REVIEW'}}"><view class="card-title">订单结算快照</view><view class="item-row" wx:for="{{session.order.items}}" wx:key="productId"><view>{{item.name}} × {{item.quantity}}</view><view>¥{{item.subtotal}}</view></view><view class="row"><text class="muted">结算金额</text><text class="amount">¥{{session.order.amount}}</text></view><view class="muted">确认后锁定商品价格，历史订单不随改价变化。</view></view>
    <view class="card" wx:if="{{session.state === 'REVIEW'}}"><view class="card-title">确认购物清单</view><view class="muted">先处理下方待确认事件，再核对商品与数量。</view><button class="primary" bindtap="confirmList" disabled="{{busy || session.pendingCount > 0 || session.basketError}}">确认清单，进入模拟支付</button><button class="danger" bindtap="cancel" disabled="{{busy}}">申请取消订单</button></view>
    <view class="card" wx:if="{{session.state === 'UNPAID'}}"><view class="card-title">模拟支付</view><view class="muted">仅记录仿真交易，不调用微信支付、不产生真实扣款。</view><button class="primary" data-success="true" bindtap="pay" disabled="{{busy}}">模拟支付成功 · ¥{{session.order.amount}}</button><button class="secondary" data-success="false" bindtap="pay" disabled="{{busy}}">模拟支付失败</button><button class="danger" bindtap="cancel" disabled="{{busy}}">申请取消订单</button></view>
    <view class="card" wx:if="{{session.order.payments.length}}"><view class="card-title">支付尝试记录</view><view class="item-row" wx:for="{{session.order.payments}}" wx:key="id"><text class="muted">第{{index + 1}}次</text><text class="tag {{item.state === 'FAILED' ? 'warn' : ''}}">{{item.state === 'SUCCESS' ? '模拟成功' : '模拟失败'}}</text></view></view>
    <view class="card"><view class="card-title">感知与融合记录</view><view wx:if="{{!session.events.length}}" class="empty">等待仿真面板产生取放数据</view><view class="event" wx:for="{{session.events}}" wx:key="id"><view class="badge-title"><text class="small">{{item.time}}</text><text class="tag {{item.status === 'PENDING' ? 'warn' : ''}}">{{item.label}}</text></view><view class="event-reason">{{item.result.reason}}</view><view class="steps"><view wx:for="{{item.result.steps}}" wx:for-item="step" wx:key="*this">{{step}}</view></view><view class="muted">候选：{{item.candidates}}</view><view wx:if="{{item.status === 'RESOLVED'}}" class="muted">确认说明：{{item.resolution_note}}</view><button wx:if="{{item.status !== 'CONFIRMED' && session.state === 'REVIEW'}}" class="secondary" data-id="{{item.id}}" bindtap="resolve">{{item.status === 'RESOLVED' ? '修正确认结果' : '核实这次取放'}}</button></view></view>
    <button wx:if="{{session.state === 'PAID' || session.state === 'CANCELLED'}}" class="primary" bindtap="home">返回选柜</button>
  </block>
  <!-- 遮罩弹层用wx:if控制创建/移除；picker只选异常答案，不承担正常选购功能。 -->
  <view class="overlay" wx:if="{{resolution}}"><view class="resolve-panel"><view class="card-title">人工核实取放事件</view><view class="muted">{{resolution.result.reason}}</view><view class="label">实际商品</view><picker range="{{productNames}}" value="{{productIndex}}" bindchange="chooseProduct">{{productNames[productIndex]}}</picker><view class="label">取放方向</view><picker range="{{directions}}" value="{{directionIndex}}" bindchange="chooseDirection">{{directions[directionIndex]}}</picker><input type="number" value="{{quantity}}" bindinput="setQuantity" placeholder="数量1—10"/><input value="{{note}}" bindinput="setNote" placeholder="填写确认说明" maxlength="500"/><view class="actions"><button class="secondary" bindtap="dismissResolution">返回</button><button class="primary" bindtap="saveResolution" disabled="{{busy}}">保存确认</button></view></view></view>
</view>
