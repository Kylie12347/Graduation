<view class="page">
  <view class="eyebrow">YOUR SHOPPING BAG</view><view class="title">购物与结算</view>
  <view wx:if="{{error}}" class="card error">{{error}}<button bindtap="refreshTap">重新加载</button><button bindtap="home">返回首页</button></view>
  <block wx:if="{{session}}">
    <view class="session-head"><text class="muted">{{session.cabinetName || '柜体'}} · {{session.cabinet_id}}</text><text class="tag">{{session.label}}</text></view>
    <view class="card" wx:if="{{session.state === 'OPEN'}}"><view class="card-title">柜门已打开</view><view class="muted">进入仿真页录入观测，提交后自动关柜。</view><button class="primary" bindtap="simulation">进入仿真页</button></view>
    <view class="card" wx:if="{{session.state === 'REVIEW'}}"><view class="card-title">等待运营人员核对</view><view class="muted">观测结果暂时无法自动结算。核对完成后，本页会自动更新付款信息。</view><button bindtap="refreshTap">刷新状态</button></view>
    <view class="card" wx:if="{{session.order && (session.state === 'UNPAID' || session.state === 'PAID')}}"><view class="card-title">{{session.state === 'PAID' ? '购物完成' : '待支付'}}</view><view class="muted" wx:if="{{session.order.route}}">{{session.order.route}}</view><view class="goods-row" wx:for="{{session.order.items}}" wx:key="productId"><image class="thumb" src="{{item.image}}" mode="aspectFit"/><view class="goods-content"><view>{{item.name}}</view><view class="muted">¥{{item.price}} × {{item.quantity}}</view></view><text>¥{{item.subtotal}}</text></view><view class="total-row"><text class="muted">合计</text><text class="amount">¥{{session.order.amount}}</text></view></view>
    <view class="card" wx:if="{{session.state === 'UNPAID'}}"><view class="muted">本系统使用模拟支付，不产生真实扣款。</view><button class="primary" data-success="true" bindtap="pay" disabled="{{busy}}">模拟支付 · ¥{{session.order.amount}}</button><button class="secondary" data-success="false" bindtap="pay" disabled="{{busy}}">演示支付失败</button></view>
    <view class="card empty" wx:if="{{session.state === 'CANCELLED'}}">本次会话已结束，无需付款。</view>
    <button wx:if="{{session.state === 'PAID' || session.state === 'CANCELLED'}}" class="primary" bindtap="home">返回首页</button>
  </block>
</view>
