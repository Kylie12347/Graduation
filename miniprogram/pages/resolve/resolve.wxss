.choice-grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx;margin-top:30rpx}.choice-card{position:relative;min-width:0;padding:22rpx;background:#fff;border:3rpx solid #e5ebdf;border-radius:24rpx;text-align:center}.choice-card.selected{border-color:#21654e;background:#edf5e9}.choice-card image{width:190rpx;height:200rpx}.checkmark{position:absolute;right:15rpx;top:15rpx;width:35rpx;height:35rpx;line-height:35rpx;border:2rpx solid #d4dfce;border-radius:50%;font-size:24rpx}.selected .checkmark{background:#21654e;color:#fff;border-color:#21654e}.choice-name{font-size:28rpx;font-weight:600}.choice-price{font-size:27rpx;color:#21654e;margin-top:8rpx}.direction-row{display:flex;gap:20rpx}.direction{flex:1;margin:0;background:#f4f7ef;color:#73856c;border:2rpx solid transparent}.direction.active{color:#21654e;background:#e8f2e3;border-color:#21654e}.quantity-row{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx}.stepper{display:flex;align-items:center;gap:30rpx}.stepper button{margin:0;width:70rpx;height:70rpx;line-height:70rpx;padding:0;background:#edf3e8;color:#21654e}.stepper text{min-width:30rpx;text-align:center}.back{background:transparent;color:#819079}
