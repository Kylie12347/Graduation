<view class="page"><view class="eyebrow">FIND A CABINET</view><view class="title">附近售货柜</view><view class="subtitle">按配置位置展示，找到身边的补给站。</view><view class="card error" wx:if="{{error}}">{{error}}<button bindtap="refreshTap">重新加载</button></view><view class="card cabinet-card" wx:for="{{cabinets}}" wx:key="id"><view class="badge-title"><view class="card-title">{{item.name}}</view><text class="tag {{item.available ? '' : 'warn'}}">{{item.available ? '可用' : '使用中'}}</text></view><view class="address">{{item.location}}</view><view class="muted">柜号 {{item.id}}</view><button class="secondary" bindtap="browse" data-id="{{item.id}}">查看柜内商品 →</button></view><view class="empty" wx:if="{{!cabinets.length}}">{{loading ? '正在查找售货柜…' : '暂未配置售货柜'}}</view><view class="footnote">请到达柜体后扫码开柜</view></view>
