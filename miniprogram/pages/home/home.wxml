<!-- 商品卡只展示货架，不绑定购买事件。实际购买仍由开柜后的取放识别。 -->
<view class="page">
  <view class="eyebrow">GUIJIAN / EVERYDAY PICKS</view>
  <view class="title">好物在柜，随取随享。</view>
  <view class="subtitle">看看柜里有什么，扫码即可开柜。</view>
  <view class="card error" wx:if="{{error}}">{{error}}<button bindtap="refreshTap">重新加载</button></view>
  <view class="card" wx:if="{{active}}"><view class="badge-title"><view class="card-title">你有一笔购物待完成</view><text class="tag">{{active.label}}</text></view><view class="muted">{{active.cabinet_id}}</view><button class="primary" bindtap="resume">继续购物 / 结算</button></view>
  <view class="store-banner card">
    <view class="badge-title"><view><view class="card-title">{{cabinet ? cabinet.name : '请扫描售货柜二维码'}}</view><view class="muted">{{cabinet ? cabinet.id + ' · ' + cabinet.location : '扫码后显示对应柜体与商品'}}</view></view><text class="tag" wx:if="{{bound}}">已扫码绑定</text><text class="tag" wx:elif="{{cabinet}}">商品预览</text></view>
    <button wx:if="{{!active && bound}}" class="primary" bindtap="openBound" loading="{{opening}}" disabled="{{opening || !cabinet.available}}">{{cabinet.available ? '开启这台售货柜' : '柜体使用中，请稍候'}}</button>
    <button wx:elif="{{!active}}" class="primary" bindtap="scan" loading="{{opening}}" disabled="{{opening}}">扫码开柜</button>
    <view class="muted scan-tip" wx:if="{{!active}}">每台柜体有独立二维码，扫码对应唯一柜体。</view>
  </view>
  <block wx:if="{{cabinet}}">
  <view class="section-head"><view class="section-title">柜内好物</view><text class="muted">商品图片为示意图</text></view>
  <view class="category-nav"><button bindtap="jumpCategory" data-category="drinks">水饮</button><button bindtap="jumpCategory" data-category="snacks">零食</button></view>
  <block wx:for="{{categories}}" wx:for-item="category" wx:key="id">
    <view id="category-{{category.id}}" class="section-title category-heading">{{category.name}}</view>
  <view class="product-grid"><view class="goods-card" wx:for="{{category.products}}" wx:key="id"><view class="picture"><image src="{{item.image}}" mode="aspectFit" data-index="{{item.sourceIndex}}" binderror="imageError"/></view><view class="goods-name">{{item.name}}</view><view class="goods-bottom"><text class="goods-price">¥{{item.price}}</text><text class="stock {{item.stock === 0 ? 'sold-out' : ''}}">{{item.stock > 0 ? '剩余 ' + item.stock + ' 件' : '暂时售罄'}}</text></view></view></view>
    <view wx:if="{{!category.products.length && products.length}}" class="card empty">本柜暂无{{category.name}}</view>
  </block>
  <view wx:if="{{!products.length}}" class="card empty">{{loading ? '正在加载商品…' : '这台柜体暂未上架商品'}}</view>
  </block>
  <view class="card nearby-entry" bindtap="nearby"><view><view class="card-title">附近售货柜</view><view class="muted">查看位置、使用状态与柜内商品</view></view><text class="entry-arrow">→</text></view>
  <view class="footnote">前端模拟取放感知 · 关柜后自动出单 · 模拟支付</view>
</view>
