.card-title{margin-bottom:10rpx}.scan-tip{margin-top:18rpx;text-align:center}.store-banner{background:#fff}.section-head{display:flex;align-items:center;justify-content:space-between;margin:36rpx 0 20rpx}.section-title{font-size:32rpx;font-weight:600}.product-grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.goods-card{padding:20rpx;background:#fff;border:1rpx solid #e4eadd;border-radius:24rpx;min-width:0}.picture{height:235rpx;border-radius:16rpx;background:#f5f7f1;display:flex;justify-content:center;align-items:center}.picture image{width:210rpx;height:210rpx}.goods-name{font-size:28rpx;font-weight:600;margin:18rpx 0 12rpx}.goods-bottom{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:6rpx}.goods-price{font-size:32rpx;font-weight:700;color:#21654e}.stock{font-size:21rpx;color:#84917c}.sold-out{color:#b55246}.nearby-entry{display:flex;align-items:center;justify-content:space-between}.entry-arrow{font-size:44rpx;color:#21654e}
